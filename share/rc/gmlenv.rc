# gmlenv.rc - the tools and the tag set of gmlfmt and gmlpass (sourced
# by both, after their option loop; the scripts are run from the source
# tree, so this file is not installed).
#
# In:  root (the project root), prog (the script's name, for messages),
#      tagset (the -tagset value, or empty), profile (the default
#      profile), SAXON, GML.
# Out: SAXON (default /usr/local/bin/transform); gml, the gml command:
#      GML as given, else the dune build of the project, built here once
#      (through opam) and run with -share root/share so that the profiles
#      are read from the source tree (the copy in _build is not
#      refreshed); bundle, the tag set's directory (it has profile.gml),
#      or profile set to the tag set when that names a profile.  -profile
#      is applied by the caller (it wins over -tagset in any order).

if(~ $#SAXON 0) SAXON=/usr/local/bin/transform
if(~ $#GML 0){
	opam exec --switch gml -- dune build --root $root --display quiet bin/main.exe || {
		echo $prog: building gml failed >[1=2]
		exit 1
	}
	gml=($root/_build/default/bin/main.exe -share $root/share)
}
if not gml=`{echo $GML}

# the tag set: a directory (with a /, or in root/share/tagset), else a
# profile name
bundle=()
if(! ~ $#tagset 0){
	dir=()
	if(~ $tagset */*) dir=$tagset
	if(~ $#dir 0 && test -d $root/share/tagset/$tagset) dir=$root/share/tagset/$tagset
	if(~ $#dir 0){
		if(test -f $root/share/profile/$tagset.gml) profile=$tagset
		if not { echo $prog: no tag set $tagset >[1=2]; exit 1 }
	}
	if not {
		if(! test -d $dir) { echo $prog: no tag set $tagset >[1=2]; exit 1 }
		bundle=`{cd $dir && pwd}
		if(~ $#bundle 0) { echo $prog: no tag set $tagset >[1=2]; exit 1 }
		if(! test -f $bundle/profile.gml) { echo $prog: $bundle/profile.gml missing >[1=2]; exit 1 }
	}
}
