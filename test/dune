(cram
 (deps
  %{bin:gml}
  %{project_root}/share/profile/starter.gml
  %{project_root}/share/profile/dcfstarter.gml
  %{project_root}/share/profile/starterset.gml
  %{project_root}/share/gmlapp/memo/profile.gml
  (glob_files %{project_root}/share/tex/*.tex)))

; a real TeX run between the passes, the TeX made by the XSLT stages
; (SaxonC's transform, as in the mkfile)

(cram
 (applies_to tex_pass tex_msgs tex_fonts3800 tex_forafter)
 (deps
  (glob_files %{project_root}/xslt/*.xsl))
 (enabled_if
  (and %{bin-available:tex} %{bin-available:transform})))

; the marks of the running heading symbols: e-TeX (pdftex), not tex

(cram
 (applies_to tex_symref)
 (deps
  (glob_files %{project_root}/xslt/*.xsl))
 (enabled_if
  (and %{bin-available:pdftex} %{bin-available:transform})))
