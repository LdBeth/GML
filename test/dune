(cram
 (deps
  %{bin:gml}
  %{project_root}/share/profile/starter.gml
  %{project_root}/share/profile/dcfstarter.gml
  %{project_root}/share/profile/starterset.gml
  %{project_root}/share/gmlapp/memo/profile.gml
  (glob_files %{project_root}/share/tex/*.tex)))

; a real TeX run between the passes, the TeX made by the XSLT stages
; (SaxonC's transform, as in the mkfile); tex_profile: the stages only

(cram
 (applies_to tex_pass tex_msgs tex_fonts3800 tex_forafter tex_profile)
 (deps
  (glob_files %{project_root}/xslt/*.xsl)
  %{project_root}/xslt/gml-shared.xml)
 (enabled_if
  (and %{bin-available:tex} %{bin-available:transform})))

; the marks of the running heading symbols, the revision bars
; (\pdfsavepos): e-TeX (pdftex), not tex

(cram
 (applies_to tex_symref tex_rc)
 (deps
  (glob_files %{project_root}/xslt/*.xsl)
  %{project_root}/xslt/gml-shared.xml)
 (enabled_if
  (and %{bin-available:pdftex} %{bin-available:transform})))

; gmlshare (bin/gmlshare.ml), a build tool with no public name: the
; test runs it by its path in the build tree

(cram
 (applies_to shared)
 (deps %{project_root}/bin/gmlshare.exe))

; gml.tex against what it shares with the engine (gml-shared.tex):
; Knuth's tex only, no stylesheets

(cram
 (applies_to tex_shared)
 (deps %{project_root}/bin/gmlshare.exe)
 (enabled_if %{bin-available:tex}))
