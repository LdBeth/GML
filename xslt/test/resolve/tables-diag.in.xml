<?xml version="1.0" encoding="UTF-8"?>
<!-- table diagnostics: a cell that is not a rectangle, arrangement lines
     of different lengths (021: one cell, so its two CWIDTHS are too
     many), a non-number in ARRANGE, invalid and abbreviated values, an
     unknown refid on the table and on a row, a :c number that does not
     exist, a table without refid, text outside a cell and outside a row;
     row definitions are found by id regardless of case, the last one
     before the table wins; a quarter turn without MINDEPTH (022 for the
     one with a MINDEPTH of *), a zero proportional width, absolute widths
     that fill a WIDTH= in picas, too few CWIDTHS (no message), a :c past
     the last cell of a header (023: its text joins the cell before); an rdef
     inside a table: the rows of that id, and the footer that comes first
     in the output, are written in full; a row of another id refers to
     its rdef -->
<gml:doc xmlns:gml="urn:x-gml:canonical"><body>
<rdef id="hole" arrange="1 1 2 / 3 1 1" cwidths="* * *"/>
<rdef id="ragged" arrange="1 2 3 / 4 x" cwidths="1i *"/>
<rdef id="vals" cwidths="* * * *" hp="1 7" align="ri c x" valign="b" concat="n" shade="l x" rotate="45"/>
<rdef id="Twice" cwidths="*"/>
<rdef id="TWICE" cwidths="* *" align="r"/>
<table refid="hole"><row><c>a</c><c>b</c><c>c</c></row></table>
<table refid="ragged"><row><c n="4">d</c></row></table>
<table refid="vals"><row><c>w</c><c>x</c><c>y</c><c>z</c></row></table>
<table refid="nosuch"><row><c>p</c><c n="2">q</c></row>
<row refid="twice">stray<c>r</c></row>text
<row refid="missing"><c n="0">s</c></row></table>
<table><row><c>t</c></row></table>
<rdef id="rot" cwidths="1i 1i" rotate="90 270" mindepth="* 2i"/>
<rdef id="zero" cwidths="0* 1i"/>
<rdef id="wide" cwidths="6i 4p6 *"/>
<rdef id="few" arrange="1 2 3" cwidths="1i"/>
<table refid="rot"><thd><c>h1</c><c>h2</c><c>h3</c></thd><row><c>u</c></row></table>
<table refid="wide" width="40p"><row><c>v</c></row></table>
<table refid="few"><row><c>f</c></row></table>
<table refid="wide"><row><c>w1</c></row><rdef id="Wide" cwidths="1i"/><row><c>w2</c></row><row refid="few"><c>w3</c></row><tft refid="wide"><c>w4</c></tft></table>
</body></gml:doc>
