 right="&amp;" pagesym="&amp;" break="yes"/></gml:scope></gml:rf><gml:pa break="yes"/><gml:rf><gml:scope kind="inline" font="hi0"><gml:sx left="Lists" fill="" right="&amp;" pagesym="&amp;" break="yes"/></gml:scope></gml:rf><h1 id="lists" anchor="lists"><gml:h level="1" break="yes"><gml:tcmark anchor="gml.tc.1" break="no"/>Lists</gml:h>
</h1><gml:sk n="0.75" unit="line" break="yes"/>The formatting profile indents lists with .in and .of and tabs to
the text with .is (html/dcfstarter-lists: one block per item with
the hanging indention, the identifier an inline block as wide as the
indention, a wider term followed by one blank).
<gml:sk n="0.75" unit="line" break="yes"/><gml:scope kind="block" in="4ch"><gml:sk n="0.75" unit="line" break="yes"/></gml:scope><gml:scope kind="block" of="4ch">1.
<gml:is spec="to 4ch min 1ch blank" break="no"/>The first item of the list, long enough to need a second output
line so that the hanging indention of the item text can be seen.
<gml:sk n="0.75" unit="line" break="yes"/>2.
<gml:is spec="to 4ch min 1ch blank" break="no"/>The second item, with a nested list:
<gml:sk n="0.75" unit="line" break="yes"/></gml:scope><gml:scope kind="block" in="8ch"><gml:sk n="0.75" unit="line" break="yes"/></gml:scope><gml:scope kind="block" in="4ch" of="4ch">a.
<gml:is spec="to 4ch min 1ch blank" break="no"/>a nested item
<gml:sk n="0.75" unit="line" break="yes"/>b.
<gml:is spec="to 4ch min 1ch blank" break="no"/>another nested item
</gml:scope><gml:scope kind="block" in="4ch"><gml:br break="yes" cause="in ir"/><gml:sk n="0.75" unit="line" break="yes"/><gml:sk n="0.75" unit="line" break="yes"/></gml:scope>A list part, at the label position.
<gml:br break="yes" cause="in ir"/><gml:sk n="0.75" unit="line" break="yes"/><gml:sk n="0.75" unit="line" break="yes"/><gml:scope kind="block" in="8ch"><gml:sk n="1" unit="line" break="yes"/></gml:scope><gml:scope kind="block" of="8ch"><gml:scope kind="inline" font="hi3">Term
</gml:scope><gml:is spec="to 8ch min 1ch blank" break="no"/><gml:scope kind="inline" font="hi3">Description
</gml:scope><gml:sk n="1" unit="line" break="yes"/><gml:scope kind="inline" font="hi2">GML
</gml:scope><gml:is spec="to 8ch min 1ch blank" break="no"/>Generalized Markup Language: tags that say what a part of the
document is, not how it looks.
<gml:sk n="1" unit="line" break="yes"/><gml:scope kind="inline" font="hi2">Too-long-term
</gml:scope><gml:is spec="to 8ch min 1ch blank" break="no"/>A term wider than the term column is followed by one blank.
</gml:scope><gml:br break="yes" cause="in ir"/><gml:sk n="0.75" unit="line" break="yes"/><h5 anchor="gml-h5-1"><gml:h level="5" break="yes">Run-in heading.</gml:h>
</h5>The text of a level five heading continues on the same line.
