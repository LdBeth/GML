#!/usr/local/plan9/bin/rc
# run.rc - the XSLT fixture tests (started by ./run, or rc with an
# absolute path).
#
#   xslt/test/run [-update] [name...]
#
# Each test is a file STAGE/NAME.in.xml, STAGE being the stylesheet
# (resolve, scope, strip-hints, html, tex), or TAGSET-STAGE for a stage
# of a tag set bundle when there is no xslt/TAGSET-STAGE.xsl (memo-html,
# memo-mail: share/gmlapp/TAGSET/STAGE.xsl).  It is
# transformed with xslt/STAGE.xsl, with the parameters listed in
# STAGE/NAME.params (name=value words), and the result is compared with
# STAGE/NAME.out.xml; the xsl:message output (standard error) is compared
# with STAGE/NAME.err (empty if absent).  A failure prints a diff -u.
# Names select tests: STAGE/NAME, NAME (that test in every stage), or
# STAGE alone (all the tests of that stage).
# -update rewrites the expected files from the current results: check
# them by eye before keeping them.
#
# The tests need no OCaml.  The gml-generated inputs were made once from
# gml/*.gml and frozen; regenerate them (and check the diffs) when the
# engine or the profile changes.  All with
#   G = gml -profile starter -set SYSDAYOFM=13 -set SYSMONTH=06 -set SYSYEAR=1986
# (gmlfmt -to ... -set ... gives the same files):
#   G gml/starter.gml          -> resolve/starter.in.xml
#   G gml/features.gml         -> resolve/features.in.xml
#   G gml/state.gml            -> scope/state.in.xml
#   gml gml/index-pi.gml       -> resolve/index-pi.in.xml (no profile)
#   resolve/features.in.xml | resolve.xsl SYSVARH=yes  -> scope/features.in.xml
#   scope/state.in.xml | scope.xsl                     -> strip-hints/scoped.in.xml
#   G gml/strip-events.gml | resolve.xsl              -> strip-hints/events.in.xml
#     (the hints strip-hints keeps, and sa re fv ix pageno);
#     strip-hints/hints is hand-written
#   G gml/tables.gml           -> resolve/tables.in.xml
#   resolve/xrefs.out.xml, resolve/index.out.xml, resolve/tables.out.xml
#     -> resolve/idempotent*.in.xml (their expected output is the input
#     itself); resolve/tables-diag and scope/tables are hand-written
# The backend inputs, with -set SYSVARP=STAGE (so :psc sections select):
#   tex  gmlfmt -to resolved -profile dcfstarter gml/tex-NAME.gml
#        -> tex/NAME.in.xml (chars, hints; params and tagset are
#        copies of chars).  tex/lines is gmlfmt -to resolved
#        gml/tex-lines.gml (starter: its own .aa tag in .ce lines) and
#        tex/features = resolve/features.out.xml: with tex/tables and
#        tex/tables-long (below) they have tags and no formatting
#        profile, which tex.xsl reports (their .err); they test the
#        writer (escaping, line scopes, the generated lists), which
#        writes any resolved XML the same way.  (Run gmlfmt outside
#        gml/: there gml/starter.gml would be read as the profile
#        starter.)  tex/dcfdefs is
#        hand-written (a formatting profile's .df/.dr/.dh); so is
#        tex/fontblank (the blank between two font changes, .pf .bf,
#        stays: :ehp2. :hp1. under dcfstarter)
#        tex/dcfstarter-tables: gmlfmt -to resolved -profile dcfstarter
#        gml/dcfstarter-tables.gml (with the G dates)
#        tex/batch: gml gml/tex-batch.gml (no profile, the SCRIPT control
#        words) | resolve.xsl; tex/query: gml -aux none.gmlaux
#        -pass 1 -passes 2 gml/tex-query.gml | resolve.xsl (the page
#        questions of the pass model, <?pn ID> and \gmlpassno); tex/dv:
#        gml gml/tex-dv.gml (test/dv.t/in.gml) | resolve.xsl (also a
#        deferred symbol, gml:symref, in a running heading and a .sx
#        field; tex/dcfstarter-tables has gml:symval).  tex/tables and
#        tex/tables-long are hand-written resolved XML: their rows in
#        full where the cells differ from the rdef (or always:
#        tables-long, the old form), else short
#   html gmlfmt -to scoped gml/html-NAME.gml   -> html/NAME.in.xml
#        (control, figs, fn, hints, index, lines, lists, scope, sections,
#        symref, text; symref: a running footing's symbol, gml:symref
#        and gml:symval, dropped; control: raw SCRIPT control words in a semantic document,
#        the hanging indention over breaks and a .is tab label, a run-in
#        .dh NBR heading, consecutive .sk skips, the .fn leader);
#        html/tables is resolve/tables.out.xml | scope.xsl;
#        html/starter and html/params are gml/starter.gml scoped,
#        fn-chapter reuses fn; features, nesting, state, values are
#        copies of scope/*.out.xml; html/index-pi is resolve/index-pi.out.xml
#        | scope.xsl (the .pi entries and .ix placement); html/cjk (line
#        ends between CJK characters) is hand-written.  HTML is made
#        only from the semantic profile (starter), not from dcfstarter.
# The tag set stages, without the G dates (a memo has no default date):
#   memo-html  gmlfmt -app memo -to scoped gml/memo-NAME.gml
#              -> memo-html/NAME.in.xml (internal, external, reply, text)
#   memo-mail  copies of memo-html/NAME.in.xml (internal, external, reply)

if(~ $#SAXON 0) SAXON=/usr/local/bin/transform
here=`{cd `{/usr/local/plan9/bin/basename -d $0} && pwd}
xslt=`{cd $here/.. && pwd}
update=no
if(~ $1 -update) { update=yes; shift }
if(~ $#TMPDIR 0) TMPDIR=/tmp
tmp=$TMPDIR/gmltest.$pid
fn sigexit { rm -f $tmp.out $tmp.err $tmp.experr }

pass=0
fail=0
failed=()
for(in in $here/*/*.in.xml){
	stage=`{/usr/local/plan9/bin/basename `{/usr/local/plan9/bin/basename -d $in}}
	name=`{/usr/local/plan9/bin/basename $in .in.xml}
	if(~ $#* 0 || ~ $stage/$name $* || ~ $name $* || ~ $stage $*){
		base=$here/$stage/$name
		params=()
		if(test -f $base.params) params=`{cat $base.params}
		sheet=$xslt/$stage.xsl
		if(! test -f $sheet && ~ $stage *-*)
			sheet=$xslt/../share/gmlapp/`{echo $stage | sed 's/-.*//'}^/^`{echo $stage | sed 's/^[^-]*-//'}^.xsl
		if(! $SAXON -s:$in -xsl:$sheet -o:$tmp.out $params >[2]$tmp.err){
			echo FAIL $stage/$name: transform failed
			cat $tmp.err
			fail=`{echo $fail + 1 | bc}
			failed=($failed $stage/$name)
		}
		if not if(~ $update yes){
			cp $tmp.out $base.out.xml
			if(test -s $tmp.err) cp $tmp.err $base.err
			if not rm -f $base.err
			echo updated $stage/$name
		}
		if not {
			if(test -f $base.err) cp $base.err $tmp.experr
			if not cp /dev/null $tmp.experr
			ok=yes
			if(! cmp -s $tmp.out $base.out.xml){
				ok=no
				echo FAIL $stage/$name: output differs
				diff -u $base.out.xml $tmp.out
			}
			if(! cmp -s $tmp.err $tmp.experr){
				ok=no
				echo FAIL $stage/$name: messages differ
				diff -u $tmp.experr $tmp.err
			}
			if(~ $ok yes){
				echo ok $stage/$name
				pass=`{echo $pass + 1 | bc}
			}
			if not {
				fail=`{echo $fail + 1 | bc}
				failed=($failed $stage/$name)
			}
		}
	}
}
if(~ $update yes) exit
echo $pass passed, $fail failed
if(! ~ $fail 0) {
	echo failed: $failed
	exit fail
}
exit ''
