#!/bin/sh
# build -- regenerate every output of release.gml into examples/out/.
#   examples/build            (from anywhere)
# Needs: the gml opam switch, SaxonC (transform; gmlfmt honours $SAXON),
# pdftex.  Every stage runs with the notes tag set (examples/notes/): the
# Starter Set plus :warn, with its own html.xsl, fo.xsl and tagset.tex.
set -e
here=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$here")
out=$here/out
src=$here/release.gml
tagset=$here/notes
pdftex=${PDFTEX:-/Library/TeX/texbin/pdftex}
mkdir -p "$out"
cd "$root"

# engine and the intermediate stages
./gmlfmt -tagset "$tagset" -to xml       "$src" > "$out/release.xml"
./gmlfmt -tagset "$tagset" -to resolved  "$src" > "$out/release.r.xml"
./gmlfmt -tagset "$tagset" -to semantic  "$src" > "$out/release.sem.xml"
./gmlfmt -tagset "$tagset" -to scoped    "$src" > "$out/release.s.xml"
./gmlfmt -tagset "$tagset" -to tex       "$src" > "$out/release.tex"
./gmlfmt -tagset "$tagset" -to scoped -set audience=internal "$src" \
  > "$out/release-internal.s.xml"

# HTML and FO: the tag set's html.xsl / fo.xsl (they import the stock
# stylesheets and add a rule for :warn) replace the stock final stage
./gmlfmt -tagset "$tagset" -to html "$src" > "$out/release.html"
./gmlfmt -tagset "$tagset" -to html -set audience=internal "$src" \
  > "$out/release-internal.html"
./gmlfmt -tagset "$tagset" -to fo   "$src" > "$out/release.fo"
cp "$root/share/html/gml.css" "$out/"

# TeX: release.tex loads notes/tagset.tex (the :warn style) by absolute
# path, so only share/tex goes on TEXINPUTS; two runs so the page
# references settle
cd "$out"
for pass in 1 2; do
  TEXINPUTS="$root/share/tex:" "$pdftex" -interaction=nonstopmode \
    release.tex > /dev/null || { echo "pdftex failed; see $out/release.log" >&2; exit 1; }
done
echo "outputs in $out"
