#!/bin/sh
# build -- regenerate every output of release.gml into examples/out/.
#   examples/build            (from anywhere)
# Needs: the gml opam switch, SaxonC (transform), pdftex.
set -e
here=$(cd "$(dirname "$0")" && pwd)
root=$(dirname "$here")
out=$here/out
src=$here/release.gml
saxon=${SAXON:-/usr/local/bin/transform}
pdftex=${PDFTEX:-/Library/TeX/texbin/pdftex}
mkdir -p "$out"
cd "$root"

# engine and the stock stages
./gmlfmt -to xml       "$src" > "$out/release.xml"
./gmlfmt -to resolved  "$src" > "$out/release.r.xml"
./gmlfmt -to semantic  "$src" > "$out/release.sem.xml"
./gmlfmt -to scoped    "$src" > "$out/release.s.xml"
./gmlfmt -to tex       "$src" > "$out/release.tex"
./gmlfmt -to scoped -set audience=internal "$src" > "$out/release-internal.s.xml"

# HTML and FO through the example's override stylesheets (they import the
# stock html.xsl / fo.xsl and add a rule for the :warn tag)
"$saxon" -s:"$out/release.s.xml" -xsl:"$here/release-html.xsl" -o:"$out/release.html"
"$saxon" -s:"$out/release-internal.s.xml" -xsl:"$here/release-html.xsl" \
  -o:"$out/release-internal.html"
"$saxon" -s:"$out/release.s.xml" -xsl:"$here/release-fo.xsl" -o:"$out/release.fo"
cp "$root/share/html/gml.css" "$out/"

# TeX: examples/ first on TEXINPUTS so gmllocal.tex styles :warn;
# two runs so the page references settle
cd "$out"
for pass in 1 2; do
  TEXINPUTS="$here:$root/share/tex:" "$pdftex" -interaction=nonstopmode \
    release.tex > /dev/null || { echo "pdftex failed; see $out/release.log" >&2; exit 1; }
done
echo "outputs in $out"
