<?xml version="1.0" encoding="UTF-8"?><fo:root xmlns:fo="http://www.w3.org/1999/XSL/Format" font-family="serif" font-size="10pt" line-height="12pt" text-align="justify" hyphenate="false" language="en"><fo:layout-master-set><fo:simple-page-master master-name="gml-title" page-width="612pt" page-height="792pt" margin-top="0.5in" margin-bottom="0.5in" margin-left="1in" margin-right="1in"><fo:region-body/></fo:simple-page-master><fo:simple-page-master master-name="gml-odd-1" page-width="612pt" page-height="792pt" margin-top="0.5in" margin-bottom="0.5in" margin-left="1in" margin-right="1in"><fo:region-body margin-top="0.5in" margin-bottom="0.5in"/><fo:region-before region-name="gml-before-odd" extent="0.5in"/><fo:region-after region-name="gml-after-odd" extent="0.5in"/></fo:simple-page-master><fo:simple-page-master master-name="gml-even-1" page-width="612pt" page-height="792pt" margin-top="0.5in" margin-bottom="0.5in" margin-left="1in" margin-right="1in"><fo:region-body margin-top="0.5in" margin-bottom="0.5in"/><fo:region-before region-name="gml-before-even" extent="0.5in"/><fo:region-after region-name="gml-after-even" extent="0.5in"/></fo:simple-page-master><fo:simple-page-master master-name="gml-odd-2" page-width="612pt" page-height="792pt" margin-top="0.5in" margin-bottom="0.5in" margin-left="1in" margin-right="1in"><fo:region-body margin-top="0.5in" margin-bottom="0.5in" column-count="2" column-gap="20pt"/><fo:region-before region-name="gml-before-odd" extent="0.5in"/><fo:region-after region-name="gml-after-odd" extent="0.5in"/></fo:simple-page-master><fo:simple-page-master master-name="gml-even-2" page-width="612pt" page-height="792pt" margin-top="0.5in" margin-bottom="0.5in" margin-left="1in" margin-right="1in"><fo:region-body margin-top="0.5in" margin-bottom="0.5in" column-count="2" column-gap="20pt"/><fo:region-before region-name="gml-before-even" extent="0.5in"/><fo:region-after region-name="gml-after-even" extent="0.5in"/></fo:simple-page-master><fo:page-sequence-master master-name="gml-pages-1"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="gml-odd-1" odd-or-even="odd"/><fo:conditional-page-master-reference master-reference="gml-even-1" odd-or-even="even"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master><fo:page-sequence-master master-name="gml-pages-2"><fo:repeatable-page-master-alternatives><fo:conditional-page-master-reference master-reference="gml-odd-2" odd-or-even="odd"/><fo:conditional-page-master-reference master-reference="gml-even-2" odd-or-even="even"/></fo:repeatable-page-master-alternatives></fo:page-sequence-master></fo:layout-master-set><fo:page-sequence master-reference="gml-title" format="i" force-page-count="no-force"><fo:flow flow-name="xsl-region-body"><fo:block text-align="end" text-align-last="end" hyphenate="false"><fo:marker marker-class-name="gml-shead">Widget Server 4.2</fo:marker><fo:block space-before="2in" space-before.conditionality="retain" line-height="1.2" font-size="24pt" font-weight="bold" text-transform="uppercase"><fo:block>Widget Server 4.2</fo:block><fo:block>Release Notes</fo:block></fo:block><fo:block space-before="2in"><fo:block space-before="12pt" font-size="10pt" font-style="italic">Document Number GC00-4200</fo:block><fo:block space-before="12pt" font-size="11pt" font-style="italic">November 6th, 2026</fo:block><fo:block space-before="12pt" font-size="12pt">The Widget Team</fo:block><fo:block space-before="12pt" font-size="10pt" font-weight="bold" font-style="italic">customer</fo:block></fo:block></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="gml-pages-1" format="i" force-page-count="no-force"><fo:static-content flow-name="gml-before-odd"><fo:block text-align="center" text-align-last="center" font-size="9pt" font-weight="bold" font-style="italic" text-transform="uppercase">customer</fo:block></fo:static-content><fo:static-content flow-name="gml-after-odd"><fo:block text-align="justify" text-align-last="justify" space-before="12pt" font-size="9pt" font-weight="bold"><fo:retrieve-marker retrieve-class-name="gml-shead" retrieve-position="last-starting-within-page" retrieve-boundary="document"/><fo:leader leader-pattern="space"/><fo:page-number/></fo:block></fo:static-content><fo:static-content flow-name="gml-before-even"><fo:block text-align="center" text-align-last="center" font-size="9pt" font-weight="bold" font-style="italic" text-transform="uppercase">customer</fo:block></fo:static-content><fo:static-content flow-name="gml-after-even"><fo:block text-align="justify" text-align-last="justify" space-before="12pt" font-size="9pt" font-weight="bold"><fo:retrieve-marker retrieve-class-name="gml-shead" retrieve-position="last-starting-within-page" retrieve-boundary="document"/><fo:leader leader-pattern="space"/><fo:page-number/></fo:block></fo:static-content><fo:static-content flow-name="xsl-footnote-separator"><fo:block text-align="start" text-align-last="start"><fo:leader leader-pattern="rule" leader-length="80pt" rule-thickness="0.3mm"/></fo:block></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block><fo:block break-before="page" font-size="20pt" font-weight="bold" keep-with-next.within-column="always" hyphenate="false" text-align="start" text-align-last="start" text-indent="0pt" space-before="1.3in" space-before.conditionality="retain" space-after="14pt"><fo:marker marker-class-name="gml-shead">Abstract</fo:marker>Abstract</fo:block><fo:block space-before="9pt" space-before.conditionality="discard">This document describes Widget Server Version 4.2,
which runs on z/OS, z/VM, Linux on Z.
</fo:block></fo:block><fo:block break-before="page"><fo:block font-size="20pt" font-weight="bold" keep-with-next.within-column="always" hyphenate="false" text-align="start" text-align-last="start" text-indent="0pt" space-before="1.3in" space-before.conditionality="retain" space-after="14pt"><fo:marker marker-class-name="gml-shead">Table of Contents</fo:marker>Table of Contents</fo:block><fo:block text-align="justify" text-align-last="justify" text-indent="0pt" start-indent="0pt" end-indent="15pt" last-line-end-indent="-15pt" space-before="9pt" font-size="10pt" font-weight="bold"><fo:basic-link internal-destination="over">Overview</fo:basic-link> <fo:leader leader-pattern="dots"/> <fo:page-number-citation ref-id="over"/></fo:block><fo:block text-align="justify" text-align-last="justify" text-indent="0pt" start-indent="0pt" end-indent="15pt" last-line-end-indent="-15pt" space-before="9pt" font-size="10pt" font-weight="bold"><fo:basic-link internal-destination="changes">Changes in 4.2</fo:basic-link> <fo:leader leader-pattern="dots"/> <fo:page-number-citation ref-id="changes"/></fo:block><fo:block text-align="justify" text-align-last="justify" text-indent="0pt" start-indent="10pt" end-indent="15pt" last-line-end-indent="-15pt" font-size="10pt"><fo:basic-link internal-destination="cfg">Configuration</fo:basic-link> <fo:leader leader-pattern="dots"/> <fo:page-number-citation ref-id="cfg"/></fo:block><fo:block text-align="justify" text-align-last="justify" text-indent="0pt" start-indent="10pt" end-indent="15pt" last-line-end-indent="-15pt" font-size="10pt"><fo:basic-link internal-destination="cap">Capacity planning</fo:basic-link> <fo:leader leader-pattern="dots"/> <fo:page-number-citation ref-id="cap"/></fo:block><fo:block text-align="justify" text-align-last="justify" text-indent="0pt" start-indent="10pt" end-indent="15pt" last-line-end-indent="-15pt" font-size="10pt"><fo:basic-link internal-destination="gml-h2-3">Platforms</fo:basic-link> <fo:leader leader-pattern="dots"/> <fo:page-number-citation ref-id="gml-h2-3"/></fo:block></fo:block><fo:block break-before="page"><fo:block font-size="20pt" font-weight="bold" keep-with-next.within-column="always" hyphenate="false" text-align="start" text-align-last="start" text-indent="0pt" space-before="1.3in" space-before.conditionality="retain" space-after="14pt"><fo:marker marker-class-name="gml-shead">List of Illustrations</fo:marker>List of Illustrations</fo:block><fo:block text-align="justify" text-align-last="justify" text-indent="0pt" start-indent="10pt" end-indent="15pt" last-line-end-indent="-15pt" space-before="3pt" font-size="10pt"><fo:basic-link internal-destination="probs">Figure 1  Problems fixed in 4.2</fo:basic-link> <fo:leader leader-pattern="dots"/> <fo:page-number-citation ref-id="probs"/></fo:block></fo:block></fo:flow></fo:page-sequence><fo:page-sequence master-reference="gml-pages-1" format="1" force-page-count="no-force" initial-page-number="1"><fo:static-content flow-name="gml-before-odd"><fo:block text-align="center" text-align-last="center" font-size="9pt" font-weight="bold" font-style="italic" text-transform="uppercase">customer</fo:block></fo:static-content><fo:static-content flow-name="gml-after-odd"><fo:block text-align="justify" text-align-last="justify" space-before="12pt" font-size="9pt" font-weight="bold"><fo:retrieve-marker retrieve-class-name="gml-shead" retrieve-position="last-starting-within-page" retrieve-boundary="document"/><fo:leader leader-pattern="space"/><fo:page-number/></fo:block></fo:static-content><fo:static-content flow-name="gml-before-even"><fo:block text-align="center" text-align-last="center" font-size="9pt" font-weight="bold" font-style="italic" text-transform="uppercase">customer</fo:block></fo:static-content><fo:static-content flow-name="gml-after-even"><fo:block text-align="justify" text-align-last="justify" space-before="12pt" font-size="9pt" font-weight="bold"><fo:retrieve-marker retrieve-class-name="gml-shead" retrieve-position="last-starting-within-page" retrieve-boundary="document"/><fo:leader leader-pattern="space"/><fo:page-number/></fo:block></fo:static-content><fo:static-content flow-name="xsl-footnote-separator"><fo:block text-align="start" text-align-last="start"><fo:leader leader-pattern="rule" leader-length="80pt" rule-thickness="0.3mm"/></fo:block></fo:static-content><fo:flow flow-name="xsl-region-body"><fo:block id="over" font-size="20pt" font-weight="bold" keep-with-next.within-column="always" hyphenate="false" text-align="start" text-align-last="start" text-indent="0pt" space-before="1.3in" space-before.conditionality="retain" space-after="14pt" break-before="page"><fo:marker marker-class-name="gml-shead">Overview</fo:marker>Overview</fo:block><fo:block space-before="9pt" space-before.conditionality="discard">Widget Server 4.2 is a maintenance release.
It contains the changes listed in <fo:basic-link internal-destination="changes">“Changes in 4.2” on page <fo:page-number-citation ref-id="changes"/></fo:basic-link>.
<fo:inline id="gml-i1-1"/>
<fo:inline id="gml-i2-1"/>
</fo:block><fo:block space-before="9pt" space-before.conditionality="discard">Contact your sales representative for the support schedule.
</fo:block><fo:block id="changes" font-size="20pt" font-weight="bold" keep-with-next.within-column="always" hyphenate="false" text-align="start" text-align-last="start" text-indent="0pt" space-before="1.3in" space-before.conditionality="retain" space-after="14pt" break-before="page"><fo:marker marker-class-name="gml-shead">Changes in 4.2</fo:marker>Changes in 4.2</fo:block><fo:block space-before="9pt" space-before.conditionality="discard">The following changes were made:
</fo:block><fo:list-block space-before="9pt" space-after="9pt" space-before.conditionality="discard" start-indent="0pt" text-indent="0pt" provisional-distance-between-starts="20pt" provisional-label-separation="5pt"><fo:list-item space-before="9pt"><fo:list-item-label start-indent="0pt" end-indent="label-end()" text-indent="0pt"><fo:block>1.</fo:block></fo:list-item-label><fo:list-item-body start-indent="20pt" text-indent="0pt"><fo:block>Faster start-up<fo:footnote><fo:inline id="fn1"/><fo:footnote-body><fo:block start-indent="0pt" end-indent="0pt" text-indent="0pt" text-align="justify" space-before="6pt" keep-together.within-page="always" font-size="9pt"><fo:inline baseline-shift="super" font-size="6pt">1</fo:inline> Measured on a cold system.</fo:block></fo:footnote-body></fo:footnote>
</fo:block></fo:list-item-body></fo:list-item><fo:list-item space-before="9pt"><fo:list-item-label start-indent="0pt" end-indent="label-end()" text-indent="0pt"><fo:block>2.</fo:block></fo:list-item-label><fo:list-item-body start-indent="20pt" text-indent="0pt"><fo:block>New <fo:inline>“quiet”</fo:inline> start option
</fo:block></fo:list-item-body></fo:list-item><fo:list-item space-before="9pt"><fo:list-item-label start-indent="0pt" end-indent="label-end()" text-indent="0pt"><fo:block>3.</fo:block></fo:list-item-label><fo:list-item-body start-indent="20pt" text-indent="0pt"><fo:block>Fixes for the problems listed in <fo:basic-link internal-destination="probs">Figure 1 on page <fo:page-number-citation ref-id="probs"/></fo:basic-link>
</fo:block></fo:list-item-body></fo:list-item></fo:list-block><fo:block space-before="9pt" space-before.conditionality="discard">This release has 3 changes
(see footnote <fo:basic-link internal-destination="fn1"><fo:inline baseline-shift="super" font-size="6pt">1</fo:inline></fo:basic-link>).
</fo:block><fo:block><fo:block space-before="9pt" space-after="9pt" padding="4pt" border-start-style="solid" border-start-width="3pt" border-start-color="#cc6600" start-indent="6pt">Important: Back up the configuration before you upgrade.
</fo:block></fo:block><fo:block id="cfg" font-size="18pt" font-weight="bold" font-style="italic" keep-with-next.within-column="always" hyphenate="false" text-align="start" text-align-last="start" text-indent="0pt" space-before="20pt" space-before.conditionality="discard" space-after="11pt">Configuration</fo:block><fo:block space-before="9pt" space-before.conditionality="discard">The configuration file now accepts these keywords:
</fo:block><fo:list-block space-before="9pt" space-after="9pt" space-before.conditionality="discard" start-indent="0pt" text-indent="0pt" provisional-distance-between-starts="50pt" provisional-label-separation="5pt"><fo:list-item space-before="9pt"><fo:list-item-label start-indent="0pt" end-indent="label-end()" text-indent="0pt"><fo:block><fo:inline font-weight="bold">timeout</fo:inline></fo:block></fo:list-item-label><fo:list-item-body start-indent="50pt" text-indent="0pt"><fo:block>Seconds to wait for a client (default 30).
<fo:inline id="gml-i1-2"/>
</fo:block></fo:list-item-body></fo:list-item><fo:list-item space-before="9pt"><fo:list-item-label start-indent="0pt" end-indent="label-end()" text-indent="0pt"><fo:block><fo:inline font-weight="bold">quiet</fo:inline></fo:block></fo:list-item-label><fo:list-item-body start-indent="50pt" text-indent="0pt"><fo:block>Suppresses the start-up banner.
<fo:inline id="gml-i1-3"/>
</fo:block></fo:list-item-body></fo:list-item></fo:list-block><fo:block space-before="9pt" space-before.conditionality="discard">An example:
</fo:block><fo:block space-before="12pt" space-after="12pt" space-before.conditionality="discard" start-indent="10pt" text-indent="0pt" text-align="start" hyphenate="false" font-size="9pt" font-family="monospace" linefeed-treatment="preserve" white-space-collapse="false" white-space-treatment="preserve" wrap-option="no-wrap"><fo:block linefeed-treatment="preserve" white-space-collapse="false" white-space-treatment="preserve" wrap-option="no-wrap" text-align="start">  server  main
    timeout 45
    quiet</fo:block></fo:block><fo:float float="before"><fo:block start-indent="2.85pt" end-indent="2.85pt" text-indent="0pt" keep-together.within-page="always" id="probs" space-after="12pt" border="0.3mm solid" padding="2pt"><fo:block start-indent="12.85pt" linefeed-treatment="preserve" white-space-collapse="false" white-space-treatment="preserve" wrap-option="no-wrap"><fo:list-block space-before="9pt" space-after="9pt" space-before.conditionality="discard" start-indent="12.85pt" text-indent="0pt" provisional-distance-between-starts="20pt" provisional-label-separation="5pt"><fo:list-item><fo:list-item-label start-indent="12.85pt" end-indent="label-end()" text-indent="0pt"><fo:block>•</fo:block></fo:list-item-label><fo:list-item-body start-indent="32.85pt" text-indent="0pt"><fo:block>WS0012: crash on empty request</fo:block></fo:list-item-body></fo:list-item><fo:list-item><fo:list-item-label start-indent="12.85pt" end-indent="label-end()" text-indent="0pt"><fo:block>•</fo:block></fo:list-item-label><fo:list-item-body start-indent="32.85pt" text-indent="0pt"><fo:block>WS0019: wrong date in log</fo:block></fo:list-item-body></fo:list-item></fo:list-block></fo:block><fo:block space-before="6pt" text-align="start" font-size="9pt" font-weight="bold">Figure 1.  Problems fixed in 4.2</fo:block></fo:block></fo:float><fo:block id="cap" font-size="18pt" font-weight="bold" font-style="italic" keep-with-next.within-column="always" hyphenate="false" text-align="start" text-align-last="start" text-indent="0pt" space-before="20pt" space-before.conditionality="discard" space-after="11pt">Capacity planning</fo:block><fo:block space-before="9pt" space-before.conditionality="discard">Each worker thread of Widget Server 4.2 serves about
<fo:inline font-family="monospace" font-size="90%">r = 250</fo:inline> requests per second, so a server with
<fo:inline font-family="monospace" font-size="90%">w = 8</fo:inline> workers handles at most
<fo:block space-before="6pt" space-after="6pt" text-indent="0pt" id="thru"><fo:table table-layout="fixed" width="100%"><fo:table-column column-width="proportional-column-width(1)"/><fo:table-column column-width="proportional-column-width(8)"/><fo:table-column column-width="proportional-column-width(1)"/><fo:table-body start-indent="0pt" end-indent="0pt"><fo:table-row><fo:table-cell><fo:block/></fo:table-cell><fo:table-cell display-align="center"><fo:block text-align="center" font-family="monospace" font-size="90%" hyphenate="false">T = w \cdot r = 8 \cdot 250 = 2000</fo:block></fo:table-cell><fo:table-cell display-align="center"><fo:block text-align="end">(1)</fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:block>requests per second, or 172800000 requests a day.
</fo:block><fo:block space-before="9pt" space-before.conditionality="discard">At start-up the 12 cache shards are warmed one after another,
and shard <fo:inline font-family="monospace" font-size="90%">k</fo:inline> takes <fo:inline font-family="monospace" font-size="90%">k</fo:inline> seconds, so the warm-up takes
<fo:block space-before="6pt" space-after="6pt" text-indent="0pt" id="warm"><fo:table table-layout="fixed" width="100%"><fo:table-column column-width="proportional-column-width(1)"/><fo:table-column column-width="proportional-column-width(8)"/><fo:table-column column-width="proportional-column-width(1)"/><fo:table-body start-indent="0pt" end-indent="0pt"><fo:table-row><fo:table-cell><fo:block/></fo:table-cell><fo:table-cell display-align="center"><fo:block text-align="center" font-family="monospace" font-size="90%" hyphenate="false">\sum_{k=1}^{12} k = {12(12+1)\over 2} = 78\ {\rm s}</fo:block></fo:table-cell><fo:table-cell display-align="center"><fo:block text-align="end">(2)</fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:block>before the server accepts requests.
</fo:block><fo:block space-before="9pt" space-before.conditionality="discard">Plan the offered load <fo:inline font-family="monospace" font-size="90%">\lambda</fo:inline> so that the utilisation
<fo:inline font-family="monospace" font-size="90%">\rho</fo:inline> stays at or below 0.8.
With <fo:inline font-family="monospace" font-size="90%">\lambda = 1600</fo:inline> requests per second and <fo:inline font-family="monospace" font-size="90%">T</fo:inline> from
<fo:basic-link internal-destination="thru">(1)</fo:basic-link>,
<fo:block space-before="6pt" space-after="6pt" text-indent="0pt" id="util"><fo:table table-layout="fixed" width="100%"><fo:table-column column-width="proportional-column-width(1)"/><fo:table-column column-width="proportional-column-width(8)"/><fo:table-column column-width="proportional-column-width(1)"/><fo:table-body start-indent="0pt" end-indent="0pt"><fo:table-row><fo:table-cell><fo:block/></fo:table-cell><fo:table-cell display-align="center"><fo:block text-align="center" font-family="monospace" font-size="90%" hyphenate="false">\rho = {\lambda \over T} = {1600 \over 2000} = 0.80 \le 0.8</fo:block></fo:table-cell><fo:table-cell display-align="center"><fo:block text-align="end">(3)</fo:block></fo:table-cell></fo:table-row></fo:table-body></fo:table></fo:block>If <fo:inline font-family="monospace" font-size="90%">\rho</fo:inline> in <fo:basic-link internal-destination="util">(3)</fo:basic-link> rises above the limit, add workers:
by <fo:basic-link internal-destination="thru">(1)</fo:basic-link> each one adds 250 requests per second.
</fo:block><fo:block id="gml-h2-3" font-size="18pt" font-weight="bold" font-style="italic" keep-with-next.within-column="always" hyphenate="false" text-align="start" text-align-last="start" text-indent="0pt" space-before="20pt" space-before.conditionality="discard" space-after="11pt">Platforms</fo:block><fo:block space-before="9pt" space-before.conditionality="discard">Supported platforms:
</fo:block><fo:list-block space-before="9pt" space-after="9pt" space-before.conditionality="discard" start-indent="0pt" text-indent="0pt" provisional-distance-between-starts="20pt" provisional-label-separation="5pt"><fo:list-item space-before="9pt"><fo:list-item-label start-indent="0pt" end-indent="label-end()" text-indent="0pt"><fo:block/></fo:list-item-label><fo:list-item-body start-indent="20pt" text-indent="0pt"><fo:block>z/OS
</fo:block></fo:list-item-body></fo:list-item><fo:list-item space-before="9pt"><fo:list-item-label start-indent="0pt" end-indent="label-end()" text-indent="0pt"><fo:block/></fo:list-item-label><fo:list-item-body start-indent="20pt" text-indent="0pt"><fo:block>z/VM
</fo:block></fo:list-item-body></fo:list-item><fo:list-item space-before="9pt"><fo:list-item-label start-indent="0pt" end-indent="label-end()" text-indent="0pt"><fo:block/></fo:list-item-label><fo:list-item-body start-indent="20pt" text-indent="0pt"><fo:block>Linux on Z
</fo:block></fo:list-item-body></fo:list-item></fo:list-block><fo:block><fo:block space-before="9pt" space-after="9pt" padding="4pt" border-start-style="solid" border-start-width="3pt" border-start-color="#cc6600" start-indent="6pt">Note: All platforms need the latest service level.
