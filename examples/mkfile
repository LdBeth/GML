# mkfile - every output of the examples, in out/ (Plan 9 mk, recipes in rc).
#
#   cd examples && mk          all of them (only what is out of date)
#   mk -a                      all of them, again
#   mk out/release.html        one of them
#   mk clean                   remove the TeX and pass by-products
#
# release.gml: the rules are the project's (../mkfile), with the notes
# tag set (notes/: the Starter Set plus :warn and math, with its own
# resolve.xsl, tex.xsl, html.xsl and tagset.tex) and out/ as OUTDIR.
# One document, one profile per application: notes/profile.gml picks
# its master by the logical device.  The engine XML (out/release.xml,
# out/release-internal.xml), and so the HTML and everything else made
# from it here (.r.xml .s.xml .sem.xml, the one-pass element TeX
# out/release.tex), is made with -set $LDEV=HTML (GMLFLAGS: gml only,
# $LDEV is no stylesheet parameter name): the semantic profile
# starter.  out/release.pdf (gmlpass) has gml's default device: the
# formatting profile dcfstarter, TeX in hint mode.  dcfdemo.gml: the
# formatting profile (share/profile/dcfstarter.gml) and -set
# SYSVARH=yes, not the notes tag set.  tategaki.gml: the tag set tate/
# (Japanese, vertical; PDF only, always with aptex).
#
# The PDF files are made in passes by ../gmlpass (README "Passes"):
# PASSES (default 4) and TEXENGINE (default pdftex; aptex) of the
# project's mkfile.  The passes work in out/passes/ (JOB.xml ... JOB.tex,
# JOB.gmlaux, JOB.sym, JOB.passK.err, JOB.log) and the PDF is moved to
# out/: the XML of a pass carries the pass options and page questions,
# and must not replace the stage files that the HTML is made from.
#
# The project's variables can be overridden in the same way (mk SAXON=...
# GML=... TEXENGINE=aptex).  mk does not see changes to the stylesheets,
# gml.tex or tagset.tex: mk -a after changing them.

MKSHELL=/usr/local/plan9/bin/rc
ROOT=`{cd .. && pwd}
TAGSET=$ROOT/examples/notes
OUTDIR=out/
PASSDIR=out/passes
MK=/usr/local/plan9/bin/mk
DCFPROFILE=$ROOT/share/profile/dcfstarter.gml
STARTERPROFILE=$ROOT/share/profile/starter.gml

OUT=\
	out/release.xml\
	out/release.r.xml\
	out/release.sem.xml\
	out/release.s.xml\
	out/release.tex\
	out/release.html\
	out/release.pdf\
	out/release-internal.xml\
	out/release-internal.r.xml\
	out/release-internal.s.xml\
	out/release-internal.html\
	out/dcfdemo.html\
	out/dcfdemo.pdf\
	out/tategaki.pdf\
	out/gml.css

all:V: $OUT

<$ROOT/mkfile

# the engine XML of release.gml for the HTML: the logical device HTML,
# so that notes/profile.gml imbeds starter (gml only, not SETS, which
# also go to every stylesheet; ROOT/mkfile has set GMLFLAGS to -I TAGSET)
GMLFLAGS=$GMLFLAGS -set '$LDEV=HTML'

out/release.xml: $TAGSET/profile.gml

# the internal edition: release.gml with -set audience=internal; the later
# stages (out/release-internal.s.xml, .html) come from the project's rules
out/release-internal.xml: release.gml $TAGSET/profile.gml
	st=()
	$GML -profile $GMLPROFILE $GMLFLAGS -set audience=internal release.gml > $target.tmp || st=$status
	if(! ~ $st '' 4) { rm -f $target.tmp; exit $st }
	mv $target.tmp $target

out/gml.css: $ROOT/share/html/gml.css
	cp $prereq $target

# the passes (these explicit rules win over the project's out/%.pdf,
# which would make the passes in out/ itself); the passes run the
# project's mkfile, with its own GMLFLAGS: the default device, so
# release.pdf comes from notes/profile.gml with dcfstarter
out/release.pdf: release.gml $TAGSET/profile.gml
	$ROOT/gmlpass -n 2 -tex $TEXENGINE -tagset $TAGSET -o $PASSDIR release.gml
	mv $PASSDIR/release.pdf $target

out/dcfdemo.pdf: dcfdemo.gml $DCFPROFILE
	$ROOT/gmlpass -n $PASSES -tex $TEXENGINE -profile $DCFPROFILE -set SYSVARH'='yes -o $PASSDIR dcfdemo.gml
	mv $PASSDIR/dcfdemo.pdf $target

# tategaki.gml: Japanese, set vertically by ApTeX (tate/tagset.tex needs a
# pTeX engine, whatever TEXENGINE says); the tag set tate/ is dcfstarter
# with Japanese literals and :ruby (mk -a after changing tate/tagset.tex)
out/tategaki.pdf: tategaki.gml tate/profile.gml tate/tex.xsl
	$ROOT/gmlpass -n $PASSES -tex aptex -tagset $ROOT/examples/tate -o $PASSDIR tategaki.gml
	mv $PASSDIR/tategaki.pdf $target

# the HTML of dcfdemo.gml: the project's stage rules (out/dcfdemo.xml,
# .r.xml, .s.xml) without the tag set, with the semantic profile starter
# (the PDF's dcfstarter formats for pages).  One pass is enough:
# resolve.xsl resolves the cross-references, forward ones too, and makes
# the TOC from the whole document.
out/dcfdemo.html: dcfdemo.gml $STARTERPROFILE
	SETS='SYSVARH=yes' $MK -a -f $ROOT/mkfile ROOT'='$ROOT TAGSET'=' OUTDIR'='out/ PROFILE'='$STARTERPROFILE $target

clean:V:
	for(d in out $PASSDIR)
		rm -f $d/*.gmlaux $d/*.sym $d/*.pass*.err $d/*.log $d/*.tmp
