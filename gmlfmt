#!/usr/local/plan9/bin/rc
# gmlfmt - run the GML pipeline on one file, result on standard output.
#
#   gmlfmt [-to xml|resolved|scoped|semantic|html|tex|fo] [-profile p]
#          [-tagset t] [-set name=value]... [-p name=value]... [-I dir]...
#          in.gml
#
#   -to       the stage to stop at (default xml):
#               xml       gml -profile p              canonical XML
#               resolved  + xslt/resolve.xsl
#               scoped    + xslt/scope.xsl            (from resolved)
#               semantic  + xslt/strip-hints.xsl      (from resolved)
#               html      + xslt/html.xsl             (from scoped)
#               fo        + xslt/fo.xsl               (from scoped)
#               tex       + xslt/tex.xsl              (from resolved)
#   -profile  the gml profile (default starter)
#   -tagset   a tag set: a bundle directory (t contains a /, or
#             GMLROOT/share/tagset/t), else a profile name (= -profile t).
#             A bundle holds profile.gml (required: the profile, unless
#             -profile is given; the directory is also the last -I),
#             optionally resolve.xsl scope.xsl strip-hints.xsl html.xsl
#             fo.xsl tex.xsl (used instead of the stock stage; they
#             normally xsl:import it) and tagset.tex (tex stage parameter
#             tex-tagset: gml.tex inputs it before gmllocal.tex).
#   -set      a symbol for gml (-set) and a parameter for every stylesheet
#   -p        a parameter for the stylesheets only (e.g. -p h1-prefix=Chapter)
#   -I        an imbed directory for gml
#
# The same tools as the mkfile: GML (default: the gml built by dune in the
# project, through opam, with -share GMLROOT/share so that the profiles
# are read from the source tree: dune exec does not refresh the copy in
# _build), SAXON (default /usr/local/bin/transform); GMLROOT is the
# project root (default: the directory of this script).

fn usage {
	echo 'usage: gmlfmt [-to xml|resolved|scoped|semantic|html|tex|fo] [-profile p] [-tagset t] [-set name=value]... [-p name=value]... [-I dir]... in.gml' >[1=2]
	exit usage
}

to=xml
profile=starter
profileopt=()
tagset=()
bundle=()
sets=()
params=()
gmlargs=()
while(! ~ $#* 0 && ~ $1 -*){
	if(~ $#* 1) usage
	switch($1){
	case -to
		to=$2
	case -profile
		profileopt=$2
	case -tagset
		tagset=$2
	case -set
		sets=($sets $2)
	case -p
		params=($params $2)
	case -I
		gmlargs=($gmlargs -I $2)
	case *
		usage
	}
	shift 2
}
if(! ~ $#* 1) usage
in=$1
if(! ~ $to xml resolved scoped semantic html tex fo) usage

if(~ $#GMLROOT 0) GMLROOT=`{/usr/local/plan9/bin/basename -d $0}
root=`{cd $GMLROOT && pwd}
xslt=$root/xslt
if(~ $#SAXON 0) SAXON=/usr/local/bin/transform
if(~ $#GML 0) gml=(opam exec --switch gml -- dune exec --root $root --display quiet -- gml -share $root/share)
if not gml=`{echo $GML}

# the tag set (after the option loop: -profile wins in any order)
if(! ~ $#tagset 0){
	dir=()
	if(~ $tagset */*) dir=$tagset
	if(~ $#dir 0 && test -d $root/share/tagset/$tagset) dir=$root/share/tagset/$tagset
	if(~ $#dir 0 && test -f $root/share/profile/$tagset.gml) profile=$tagset
	if(~ $#dir 0 && ! test -f $root/share/profile/$tagset.gml){
		echo gmlfmt: no tag set $tagset >[1=2]
		exit 1
	}
	if(! ~ $#dir 0){
		if(! test -d $dir) { echo gmlfmt: no tag set $tagset >[1=2]; exit 1 }
		bundle=`{cd $dir && pwd}
		if(~ $#bundle 0) { echo gmlfmt: no tag set $tagset >[1=2]; exit 1 }
		if(! test -f $bundle/profile.gml) { echo gmlfmt: $bundle/profile.gml missing >[1=2]; exit 1 }
		profile=$bundle/profile.gml
		gmlargs=($gmlargs -I $bundle)
	}
}
if(! ~ $#profileopt 0) profile=$profileopt

if(~ $#TMPDIR 0) TMPDIR=/tmp
tmp=$TMPDIR/gmlfmt.$pid
fn sigexit { rm -f $tmp.xml $tmp.r.xml $tmp.s.xml }

setargs=()
for(s in $sets) setargs=($setargs -set $s)

# xsl stylesheet input [-o:output]
fn xsl {
	sheet=$xslt/$1.xsl
	if(! ~ $#bundle 0 && test -f $bundle/$1.xsl) sheet=$bundle/$1.xsl
	if(! test -f $sheet) { echo gmlfmt: $sheet not written yet >[1=2]; exit 1 }
	src=$2
	shift 2
	$SAXON -s:$src -xsl:$sheet $* $sets $params || exit 1
}

# gml returns 4 after warnings (DCF return codes): still a result
fn rungml {
	st=()
	$gml -profile $profile $gmlargs $setargs $in || st=$status
	if(! ~ $st '' 4) exit $st
	status=()
}

if(~ $to xml){
	rungml
	exit
}
rungml > $tmp.xml
switch($to){
case resolved
	xsl resolve $tmp.xml
case semantic
	xsl resolve $tmp.xml -o:$tmp.r.xml
	xsl strip-hints $tmp.r.xml
case tex
	xsl resolve $tmp.xml -o:$tmp.r.xml
	tagparam=()
	if(! ~ $#bundle 0 && test -f $bundle/tagset.tex) tagparam=tex-tagset^'='^$bundle/tagset.tex
	xsl tex $tmp.r.xml $tagparam
case scoped
	xsl resolve $tmp.xml -o:$tmp.r.xml
	xsl scope $tmp.r.xml
case html fo
	xsl resolve $tmp.xml -o:$tmp.r.xml
	xsl scope $tmp.r.xml -o:$tmp.s.xml
	xsl $to $tmp.s.xml
}
