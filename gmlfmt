#!/usr/local/plan9/bin/rc
# gmlfmt - run the GML pipeline on one file, result on standard output.
#
#   gmlfmt [-to xml|resolved|scoped|semantic|html|tex] [-profile p]
#          [-tagset t] [-set name=value]... [-p name=value]... [-I dir]...
#          in.gml
#
#   -to       the stage to stop at (default xml):
#               xml       gml -profile p              canonical XML
#               resolved  + xslt/resolve.xsl
#               scoped    + xslt/scope.xsl            (from resolved)
#               semantic  + xslt/strip-hints.xsl      (from resolved)
#               html      + xslt/html.xsl             (from scoped)
#               tex       + xslt/tex.xsl              (from resolved)
#   -profile  the gml profile (default starter)
#   -tagset   a tag set: a bundle directory (t contains a /, or
#             GMLROOT/share/tagset/t), else a profile name (= -profile t).
#             A bundle holds profile.gml (required: the profile, unless
#             -profile is given; the directory is also the last -I),
#             optionally resolve.xsl scope.xsl strip-hints.xsl html.xsl
#             tex.xsl (used instead of the stock stage; they normally
#             xsl:import it) and tagset.tex (tex stage parameter
#             tex-tagset: gml.tex inputs it before gmllocal.tex).
#             A bundle's profile may choose its master profile by the
#             logical device, as DCF profiles do (.if &$LDEV eq HTML
#             .im starter, else .im dcfstarter: examples/notes): see
#             -to below.
#   -set      a symbol for gml (-set) and a parameter for every stylesheet
#
# The device: -to html, scoped and semantic (the semantic path, the HTML
# and what it is made from) give gml -set '$LDEV=HTML' (to gml only:
# $LDEV is not a valid stylesheet parameter name), before the -set
# options; xml, resolved and tex keep gml's default device (3800N6).
#   -p        a parameter for the stylesheets only (e.g. -p h1-prefix=Chapter)
#   -I        an imbed directory for gml
#
# The same tools as the mkfile: GML (default: the gml built by dune in the
# project, through opam, run with -share GMLROOT/share so that the
# profiles are read from the source tree: the copy in _build is not
# refreshed), SAXON (default /usr/local/bin/transform); GMLROOT is the
# project root (default: the directory of this script).  The defaults
# and the tag set are share/rc/gmlenv.rc, shared with gmlpass.

fn usage {
	echo 'usage: gmlfmt [-to xml|resolved|scoped|semantic|html|tex] [-profile p] [-tagset t] [-set name=value]... [-p name=value]... [-I dir]... in.gml' >[1=2]
	exit usage
}

to=xml
profile=starter
profileopt=()
tagset=()
sets=()
params=()
gmlargs=()
while(! ~ $#* 0 && ~ $1 -*){
	if(~ $#* 1) usage
	switch($1){
	case -to
		to=$2
	case -profile
		profileopt=$2
	case -tagset
		tagset=$2
	case -set
		sets=($sets $2)
	case -p
		params=($params $2)
	case -I
		gmlargs=($gmlargs -I $2)
	case *
		usage
	}
	shift 2
}
if(! ~ $#* 1) usage
in=$1
if(! ~ $to xml resolved scoped semantic html tex) usage

if(~ $#GMLROOT 0) GMLROOT=`{/usr/local/plan9/bin/basename -d $0}
root=`{cd $GMLROOT && pwd}
xslt=$root/xslt
prog=gmlfmt
. $root/share/rc/gmlenv.rc
if(! ~ $#bundle 0){
	profile=$bundle/profile.gml
	gmlargs=($gmlargs -I $bundle)
}
if(! ~ $#profileopt 0) profile=$profileopt

if(~ $#TMPDIR 0) TMPDIR=/tmp
tmp=$TMPDIR/gmlfmt.$pid
fn sigexit { rm -f $tmp.xml $tmp.r.xml $tmp.s.xml }

setargs=()
for(s in $sets) setargs=($setargs -set $s)
# the semantic stages (html, scoped, semantic) are for the logical device
# HTML: gml gets -set $LDEV=HTML (gml only: $LDEV is not a valid name
# for a stylesheet parameter), before the -set words
if(~ $to html scoped semantic) setargs=(-set '$LDEV=HTML' $setargs)

# xsl stylesheet input [-o:output]
fn xsl {
	sheet=$xslt/$1.xsl
	if(! ~ $#bundle 0 && test -f $bundle/$1.xsl) sheet=$bundle/$1.xsl
	if(! test -f $sheet) { echo gmlfmt: $sheet not written yet >[1=2]; exit 1 }
	src=$2
	shift 2
	$SAXON -s:$src -xsl:$sheet $* $sets $params || exit 1
}

# gml returns 4 after warnings (DCF return codes): still a result
fn rungml {
	st=()
	$gml -profile $profile $gmlargs $setargs $in || st=$status
	if(! ~ $st '' 4) exit $st
	status=()
}

if(~ $to xml){
	rungml
	exit
}
rungml > $tmp.xml
switch($to){
case resolved
	xsl resolve $tmp.xml
case semantic
	xsl resolve $tmp.xml -o:$tmp.r.xml
	xsl strip-hints $tmp.r.xml
case tex
	xsl resolve $tmp.xml -o:$tmp.r.xml
	tagparam=()
	if(! ~ $#bundle 0 && test -f $bundle/tagset.tex) tagparam=tex-tagset^'='^$bundle/tagset.tex
	xsl tex $tmp.r.xml $tagparam
case scoped
	xsl resolve $tmp.xml -o:$tmp.r.xml
	xsl scope $tmp.r.xml
case html
	xsl resolve $tmp.xml -o:$tmp.r.xml
	xsl scope $tmp.r.xml -o:$tmp.s.xml
	xsl html $tmp.s.xml
}
